# App
APP_PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-too-use-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Seed (admin user created on first run)
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=Admin@123

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Google Analytics (service account with Viewer access to the GA4 property)
GA_PROPERTY_ID=123456789
# Path to the service-account JSON when running locally
GA_KEY_FILE=GAServiceKey.json
# In production, prefer the JSON inline (raw or base64) instead of a file
GA_CREDENTIALS=
# Transaction pooler (port 6543) — app queries
DATABASE_URL=postgresql://user:password@pooler.supabase.com:6543/portfolio_db
# Session pooler (port 5432) — migrations / CLI
DIRECT_URL=postgresql://user:password@pooler.supabase.com:5432/portfolio_db
