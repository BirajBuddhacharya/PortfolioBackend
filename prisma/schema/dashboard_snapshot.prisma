// Owned by: src/modules/dashboard
// Legacy table from the original seeded demo dashboard. The API no longer
// reads or writes it — /dashboard/snapshot is computed from real content rows.
// Kept only so existing databases do not need a destructive drop migration.

model DashboardSnapshot {
  id        Int      @id @default(1)
  chartBars Json // number[]
  topPages  Json // { path: string; views: number; pct: number }[]
  activity  Json // { text: string; time: string }[]
  updatedAt DateTime @updatedAt

  @@map("dashboard_snapshot")
}
