// Owned by: src/modules/blog

enum BlogStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?
  content     String?    @db.Text
  status      BlogStatus @default(DRAFT)
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  tags        Tag[]

  @@map("blog_posts")
}
