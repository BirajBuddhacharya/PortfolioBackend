// Owned by: src/modules/projects
// `content` is the markdown body rendered on the project detail page —
// it replaces the old structured `sections` array.
enum ProjectStatus {
  ARCHIVED
  ACTIVE
}

model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  blurb       String?
  summary     String?   @db.Text
  content     String?   @db.Text
  year        String?
  status      ProjectStatus  @default(ACTIVE)
  gallery     String[]
  metrics     Json      @default("[]")
  live        String?
  repo        String?
  coverImage  String?
  coverHeight Int       @default(260)
  coverAccent String    @default("#FF6B6B")
  coverColor  String    @default("#141418")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tags        Tag[]

  @@map("projects")
}
